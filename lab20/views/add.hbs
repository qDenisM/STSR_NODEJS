<div class="list-container">
  {{#each entries}}
    {{> entry-row disabled=../disabled}}
  {{/each}}
</div>

<form action="/Add" method="POST" class="entry-form">
  <div class="form-row">
    <input type="text" name="name" placeholder="Фамилия, имя, отчество" class="input-name">
    <input type="text" name="phone" placeholder="Телефон" class="input-phone">
  </div>
  <div class="btn-group">
    <button type="submit" class="btn btn-add">Добавить</button>
    {{{cancelLink}}}
  </div>
</form>
